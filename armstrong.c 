#include<stdio.h>

int main()
{
    int n, original, remainder, result = 0;

    printf("Enter a number: ");
    scanf("%d", &n);

    original = n;

    while(original != 0)
    {
        remainder = original % 10;
        result = result + (remainder * remainder * remainder);
        original = original / 10;
    }

    if(result == n)
        printf("Armstrong Number");
    else
        printf("Not Armstrong Number");

    return 0;
}